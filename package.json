{
  "name": "ha-dashboard-ui",
  "version": "0.1.0",
  "description": "Custom dashboard rows and cards for Home Assistant, built to be previewed and tested in Storybook.",
  "type": "module",
  "license": "MIT",
  "repository": "github:BrendanAnnable/ha-dashboard-ui",
  "keywords": [
    "home-assistant",
    "lovelace",
    "dashboard",
    "custom-card",
    "hacs"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}
